#!/bin/sh
# moo-copy: put stdin on the system clipboard, without any cow in the way.
# Usage: printf '%s' 'npm install' | moo-copy

if command -v pbcopy >/dev/null 2>&1; then
  pbcopy
elif [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy >/dev/null 2>&1; then
  wl-copy
elif command -v xclip >/dev/null 2>&1; then
  xclip -selection clipboard
elif command -v xsel >/dev/null 2>&1; then
  xsel --clipboard --input
elif command -v clip.exe >/dev/null 2>&1; then
  clip.exe
else
  echo "moo-copy: no clipboard tool found (install pbcopy, wl-copy, xclip, or xsel)" >&2
  exit 1
fi && echo "Copied to clipboard. Moo." >&2
